{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Media Studio",
  "version": "0.1.0",
  "identifier": "com.localmediastudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Media Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0a0a0f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$LOCALAPPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Local media downloader powered by yt-dlp + FFmpeg",
    "longDescription": "Local Media Studio downloads media from supported URLs and converts to MP3/MP4 locally using yt-dlp and FFmpeg. Offline-first, no cloud services.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
